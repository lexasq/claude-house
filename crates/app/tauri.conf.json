{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude House",
  "version": "0.1.0",
  "identifier": "dev.claudehouse.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Claude House",
        "width": 780,
        "height": 640,
        "minWidth": 520,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
